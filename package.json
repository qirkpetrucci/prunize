{
  "name": "prunize",
  "version": "0.1.3",
  "description": "Intelligent optimizer that detects the best prompt format to reduce LLM token usage",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "clean": "rm -rf dist",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "json",
    "yaml",
    "xml",
    "html",
    "optimization",
    "llm",
    "prompt",
    "token",
    "csv",
    "toon",
    "compression",
    "auto-detection",
    "prune",
    "minimize"
  ],
  "author": "Anwarul Haqi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qirkpetrucci/prunize.git"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.8",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
